<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Devinno.Vision</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573</WarningsAsErrors>

    <PackageId>Devinno.Vision</PackageId>
    <Version>0.1.0</Version>
    <Authors>Devinno</Authors>
    <Company>Devinno</Company>
    <Description>Thin vision inspection framework over OpenCvSharp4 — images with automatic disposal and coordinate tracking, inspection jobs with steps, ROI, timeouts and uniform results, a camera interface, a small toolkit and recipes made in a teaching tool. The result view for Devinno.UI is Devinno.Vision.UI; USB cameras are Devinno.Vision.FlashCap.</Description>
    <PackageTags>vision;inspection;machine-vision;opencv;opencvsharp;onnx;anomaly-detection;industrial;llm;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Devinno</Copyright>
    <!-- docs/llms.txt 원본은 저장소 루트의 llms.txt (../Directory.Build.props 의 _DvVersionedLlms) -->
    <DevinnoLlmsFile>$(MSBuildProjectDirectory)\..\..\llms.txt</DevinnoLlmsFile>
  </PropertyGroup>

  <!-- 패키지 문서 (AI · 사람용): 규칙과 저장소 루트의 vision-*.md 전부. C# API 설명은 Devinno.Vision.xml.
       참조한 프로젝트가 빌드하면 .devinno/Devinno.Vision/ 으로 복사된다 (../Directory.Build.props) -->
  <ItemGroup>
    <None Include="..\..\llm-rules.md" Pack="true" PackagePath="docs\" />
    <None Include="..\..\vision-*.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <!-- ONNX 추론 (CPU). 코어가 참조한다. GPU 용 패키지와의 공존은 확인하지 않았다 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>

  <!-- 화면(DvVisionView)은 Devinno.Vision.UI 패키지에 있다. 코어는 Devinno.UI 를 참조하지 않는다. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Devinno.Vision.Tests" />
    <InternalsVisibleTo Include="Devinno.Vision.UI" />
  </ItemGroup>

</Project>
