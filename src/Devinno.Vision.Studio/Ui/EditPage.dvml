<DvPageFrame vm="Devinno.Vision.Studio.Ui.EditPage" style="padding:16; gap:16">
  <DvStyle>
    .name { font-size: token(font.body); color: token(text) }
    .sub { font-size: 13; color: token(text-muted) }
    .meta { font-size: 11; color: token(text-subtle) }
    .field { font-size: 13; color: token(text-muted); width: 88 }
    .ok { color: token(tone-success-fg); font-weight: bold }
    .ng { color: token(tone-danger-fg); font-weight: bold }
    .empty-title { font-size: token(font.title); font-weight: bold; color: token(text) }
  </DvStyle>
  <DvRow gap="sm">
    <DvIcon icon="fa-lightbulb" style="font-size:13; color: token(tone-warning-fg)"/>
    <DvLabel class="sub" text="{Hint}"/>
  </DvRow>
  <DvRow id="body" grow="1" style="align-items:stretch; gap:16; height:0">
    <!-- 가운데: 이미지 (남는 폭 전부) -->
    <DvCard title="{ImageTitle}" badge="{ImageBadge}" style="flex:1; width:0">
      <DvRow gap="sm" visible="{Wide}">
        <DvButton variant="secondary" icon="fa-image" text="기준 이미지" onclick="OpenBase" disabled="{NoProject}"/>
        <DvButton id="btnTeach" variant="secondary" icon="fa-crosshairs" text="기준 티칭" onclick="Teach" disabled="{NoBase}"/>
        <DvSpacer/>
        <DvButton id="btnRun" variant="primary" icon="fa-play" text="실행" onclick="RunBase" disabled="{CannotRun}"/>
        <DvButton id="btnRunOther" variant="secondary" icon="fa-folder-open" text="다른 이미지로 실행" onclick="RunOther" disabled="{CannotRun}"/>
      </DvRow>
      <!-- 좁은 창: 준비 줄 · 실행 줄 -->
      <DvRow gap="sm" visible="{Compact}">
        <DvButton variant="secondary" icon="fa-image" text="기준 이미지" onclick="OpenBase" disabled="{NoProject}"/>
        <DvButton variant="secondary" icon="fa-crosshairs" text="기준 티칭" onclick="Teach" disabled="{NoBase}"/>
      </DvRow>
      <DvRow gap="sm" visible="{Compact}">
        <DvButton variant="primary" icon="fa-play" text="실행" onclick="RunBase" disabled="{CannotRun}"/>
        <DvButton variant="secondary" icon="fa-folder-open" text="다른 이미지로 실행" onclick="RunOther" disabled="{CannotRun}"/>
      </DvRow>

      <DvStack gap="sm" style="flex:1; height:0; align-items:center; justify-content:center" visible="{NoBase}">
        <DvIcon icon="fa-image" style="font-size:40; color: token(text-subtle)"/>
        <DvLabel class="empty-title" text="{EmptyTitle}"/>
        <DvLabel class="sub" text="{EmptyText}" style="text-align:center"/>
        <DvButton id="btnOpenBase" variant="primary" icon="fa-image" text="기준 이미지 열기" onclick="OpenBase" visible="{HasProject}"/>
      </DvStack>
      <VisionView source="{View}" style="flex:1; height:0" visible="{HasBase}"/>

      <DvRow gap="sm">
        <DvBadge text="{ResultBadge}" tone="{ResultTone}" visible="{HasResultBadge}"/>
        <DvLabel class="sub" text="{LastRun}"/>
      </DvRow>
      <DvDataGrid items="{LastValues}" row-height="30" header-height="30" visible="{HasValues}" style="height:122; border-radius: token(radius.md)">
        <DvColumn header="검사" field="Check" width="140"/>
        <DvColumn header="값" field="Name" width="170"/>
        <DvColumn header="측정" field="Value" width="110" align="right"/>
        <DvColumn header="기준" field="Range"/>
        <DvColumn header="판정" field="Judge" width="64" align="center" cell-class="JudgeClass"/>
      </DvDataGrid>
    </DvCard>

    <!-- 오른쪽: 속성 -->
    <DvStack width="{PanelWidth}" style="flex-shrink:0; gap:16; overflow:scroll">
      <DvCard title="검사 속성" grow="1" visible="{NoSelection}">
        <DvStack gap="sm" grow="1" style="align-items:center; justify-content:center">
          <DvIcon icon="fa-list-check" style="font-size:28; color: token(text-subtle)"/>
          <DvLabel class="sub" text="{NoSelectionText}" style="text-align:center"/>
        </DvStack>
      </DvCard>

      <DvCard title="{SelectedTitle}" badge="{PanelBadge}" visible="{HasSelection}">
        <DvLabel class="meta" text="{RoiText}"/>
        <DvRow gap="sm">
          <DvLabel class="field" text="이름"/>
          <DvInput value="{Bind CheckName}" style="flex:1; width:0"/>
        </DvRow>

        <DvStack gap="sm" visible="{HasBlob}">
          <DvLabel class="sub" text="이진화"/>
          <DvSegment value="{Bind BlobMode}" fill="true">
            <DvOption value="Otsu" text="자동 (Otsu)"/>
            <DvOption value="Fixed" text="고정 문턱"/>
          </DvSegment>
          <DvRow gap="sm">
            <DvLabel class="field" text="문턱"/>
            <DvInput value="{Bind BlobThreshold}" keyboard-type="numeric" min="0" max="255" style="flex:1; width:0"/>
          </DvRow>
          <DvCheckBox text="어두운 것을 찾기 (반전)" value="{Bind BlobInvert}"/>
          <DvRow gap="sm">
            <DvLabel class="field" text="최소 면적"/>
            <DvInput value="{Bind BlobMinArea}" keyboard-type="numeric" min="0" unit="px²" style="flex:1; width:0"/>
          </DvRow>
        </DvStack>

        <DvRow gap="sm" visible="{IsBlobAlign}">
          <DvIcon icon="fa-location-crosshairs" style="font-size:13; color: token(text-muted)"/>
          <DvLabel class="sub" text="{ReferenceText}"/>
        </DvRow>

        <DvRow gap="sm" visible="{IsBlobCount}">
          <DvLabel class="field" text="개수"/>
          <DvInput value="{Bind CountMin}" keyboard-type="numeric" min="0" style="flex:1; width:0"/>
          <DvLabel class="sub" text="~"/>
          <DvInput value="{Bind CountMax}" keyboard-type="numeric" min="0" style="flex:1; width:0"/>
        </DvRow>

        <DvStack gap="sm" visible="{IsPixelCount}">
          <DvRow gap="sm">
            <DvLabel class="field" text="밝기"/>
            <DvInput value="{Bind PixelLow}" keyboard-type="numeric" min="0" max="255" style="flex:1; width:0"/>
            <DvLabel class="sub" text="~"/>
            <DvInput value="{Bind PixelHigh}" keyboard-type="numeric" min="0" max="255" style="flex:1; width:0"/>
          </DvRow>
          <DvRow gap="sm">
            <DvLabel class="field" text="최대 픽셀"/>
            <DvInput value="{Bind PixelMax}" keyboard-type="numeric" min="0" style="flex:1; width:0"/>
          </DvRow>
        </DvStack>

        <DvRow gap="sm" visible="{IsBrightness}">
          <DvLabel class="field" text="평균 밝기"/>
          <DvInput value="{Bind BrightMin}" keyboard-type="numeric" min="0" max="255" style="flex:1; width:0"/>
          <DvLabel class="sub" text="~"/>
          <DvInput value="{Bind BrightMax}" keyboard-type="numeric" min="0" max="255" style="flex:1; width:0"/>
        </DvRow>

        <DvStack gap="sm" visible="{IsLength}">
          <DvRow gap="sm">
            <DvLabel class="field" text="에지"/>
            <DvSelect value="{Bind LengthPolarity}" style="flex:1; width:0">
              <DvOption value="BrightObject" text="밝은 물체"/>
              <DvOption value="DarkObject" text="어두운 물체"/>
              <DvOption value="Both" text="둘 다"/>
            </DvSelect>
          </DvRow>
          <DvRow gap="sm">
            <DvLabel class="field" text="최소 대비"/>
            <DvInput value="{Bind LengthContrast}" keyboard-type="numeric" min="0" style="flex:1; width:0"/>
          </DvRow>
          <DvRow gap="sm">
            <DvLabel class="field" text="공칭값"/>
            <DvInput value="{Bind LengthNominal}" keyboard-type="numeric" unit="{LengthUnit}" style="flex:1; width:0"/>
          </DvRow>
          <DvRow gap="sm">
            <DvLabel class="field" text="위 공차"/>
            <DvInput value="{Bind LengthPlus}" keyboard-type="numeric" min="0" unit="{LengthUnit}" style="flex:1; width:0"/>
          </DvRow>
          <DvRow gap="sm">
            <DvLabel class="field" text="아래 공차"/>
            <DvInput value="{Bind LengthMinus}" keyboard-type="numeric" min="0" unit="{LengthUnit}" style="flex:1; width:0"/>
          </DvRow>
        </DvStack>

        <DvRow gap="sm" visible="{HasCode}">
          <DvLabel class="field" text="NG 코드"/>
          <DvInput value="{Bind Code}" style="flex:1; width:0"/>
        </DvRow>
      </DvCard>

      <DvCard title="캘리브레이션" badge="{CalibrationBadge}">
        <DvInput value="{Bind Calibration}" placeholder="비우면 px 로 판정" unit="mm/px" disabled="{NoProject}"/>
      </DvCard>
    </DvStack>
  </DvRow>
</DvPageFrame>
