<DvRow vm="Devinno.Vision.Studio.Ui.StatusBar" style="height:32; padding:0 16; gap:12; background: token(surface-raised); border: 1 token(border)">
  <DvStyle>
    .notice { font-size: token(font.body); color: token(text) }
    .notice-error { color: token(tone-danger-fg) }
    .icon { font-size: 14; color: token(tone-success-fg) }
    .icon-error { color: token(tone-danger-fg) }
  </DvStyle>
  <DvIcon class="{IconClass}" icon="{NoticeIcon}"/>
  <DvLabel class="{NoticeClass}" text="{Notice}" style="white-space:nowrap"/>
  <DvSpacer/>
  <DvLabel class="caption" text="{Mcp}" style="white-space:nowrap"/>
</DvRow>
