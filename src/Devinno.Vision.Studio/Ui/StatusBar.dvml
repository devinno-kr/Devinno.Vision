<DvRow vm="Devinno.Vision.Studio.Ui.StatusBar" style="height:32; padding:0 16; gap:8; background: token(surface); border: 1 token(border)">
  <DvStyle>
    .notice { font-size: 13; color: token(text-muted) }
    .notice-error { color: token(tone-danger-fg) }
    .icon { font-size: 13; color: token(tone-success-fg) }
    .icon-error { color: token(tone-danger-fg) }
  </DvStyle>
  <DvIcon class="{IconClass}" icon="{NoticeIcon}"/>
  <DvLabel class="{NoticeClass}" text="{Notice}" style="white-space:nowrap"/>
  <DvSpacer/>
  <DvBadge text="{Mcp}" tone="{McpTone}" visible="{HasMcp}"/>
</DvRow>
