<DvStack vm="Devinno.Vision.Studio.Ui.CheckListBar" style="width:264; padding:16; gap:8; background: token(surface); border: 1 token(border)">
  <DvStyle>
    .item { padding:8 12; gap:8; border-radius: token(radius.md) }
    .item:hover { background: token(surface-raised) }
    .item-on, .item-on:hover { background: token(surface-overlay) }
    .name { font-size: token(font.body); color: token(text) }
    .meta { font-size: 11; color: token(text-subtle) }
    .ico { font-size: 15; color: token(text-muted); width: 20 }
    .ico-on { color: token(primary) }
    .empty { font-size: 13; color: token(text-muted) }
  </DvStyle>
  <DvRow gap="sm">
    <DvLabel class="title" text="@list.title"/>
    <DvBadge text="{CountText}" tone="neutral" visible="{HasRows}"/>
    <DvSpacer/>
    <DvButton id="btnAdd" variant="primary" icon="fa-plus" text="@list.add" onclick="Add" disabled="{NoProjectFlag}"/>
  </DvRow>
  <DvRepeat items="{Rows}" gap="xs" grow="1" style="overflow:scroll" visible="{HasRows}">
    <DvRow class="{Item.ItemClass}" onclick="Pick">
      <DvIcon class="{Item.IconClass}" icon="{Item.Icon}"/>
      <DvStack gap="none" style="flex:1; width:0">
        <DvLabel class="name" text="{Item.Name}" style="white-space:nowrap"/>
        <DvLabel class="meta" text="{Item.Kind}"/>
      </DvStack>
      <DvBadge text="{Item.Badge}" tone="{Item.Tone}"/>
    </DvRow>
  </DvRepeat>
  <DvStack gap="sm" grow="1" style="align-items:center; justify-content:center" visible="{NoRows}">
    <DvIcon icon="fa-list-check" style="font-size:28; color: token(text-subtle)"/>
    <DvLabel class="empty" style="text-align:center" text="{EmptyText}"/>
  </DvStack>
  <DvRow gap="sm">
    <DvButton variant="secondary" icon="fa-arrow-up" onclick="Up" disabled="{CannotUp}" style="flex:1; width:0"/>
    <DvButton variant="secondary" icon="fa-arrow-down" onclick="Down" disabled="{CannotDown}" style="flex:1; width:0"/>
    <DvButton id="btnRemove" variant="secondary" icon="fa-trash" text="@list.remove" onclick="Remove" disabled="{NoSelection}" style="flex:2; width:0"/>
  </DvRow>
</DvStack>
