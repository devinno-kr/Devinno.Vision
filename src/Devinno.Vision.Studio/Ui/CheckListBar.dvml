<DvStack vm="Devinno.Vision.Studio.Ui.CheckListBar" gap="sm" padding="md" style="width:260; background: token(surface); border: 1 token(border)">
  <DvRow gap="sm">
    <DvLabel class="title" text="검사 목록"/>
    <DvSpacer/>
    <DvButton id="btnAdd" variant="primary" icon="fa-plus" text="추가" onclick="Add" disabled="{NoProjectFlag}"/>
  </DvRow>
  <DvListBox value="{Bind SelectedId}" items="{Rows}" item-value="Id" item-text="Text" grow="1" visible="{HasRows}"/>
  <DvCard grow="1" visible="{NoRows}">
    <DvLabel class="body" style="color: token(text-muted)" text="{EmptyText}"/>
  </DvCard>
  <DvRow gap="xs">
    <DvButton variant="secondary" icon="fa-arrow-up" text="위로" onclick="Up" disabled="{CannotUp}" style="flex:1; width:0"/>
    <DvButton variant="secondary" icon="fa-arrow-down" text="아래로" onclick="Down" disabled="{CannotDown}" style="flex:1; width:0"/>
    <DvButton id="btnRemove" variant="danger" icon="fa-trash" text="삭제" onclick="Remove" disabled="{NoSelection}" style="flex:1; width:0"/>
  </DvRow>
</DvStack>
