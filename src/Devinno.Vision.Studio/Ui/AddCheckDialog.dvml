<DvDialogFrame vm="Devinno.Vision.Studio.Ui.AddCheckDialog" title="@add.title" style="width:420">
  <DvLabel class="label muted" text="@add.name"/>
  <DvInput value="{Bind CheckName}" placeholder="@add.name.hint"/>
  <DvLabel class="label muted" text="@add.kind"/>
  <DvSelect value="{Bind Kind}">
    <DvOption value="BlobAlign" text="@add.kind.BlobAlign"/>
    <DvOption value="BlobCount" text="@kind.BlobCount"/>
    <DvOption value="PixelCount" text="@kind.PixelCount"/>
    <DvOption value="Brightness" text="@kind.Brightness"/>
    <DvOption value="Length" text="@kind.Length"/>
    <DvOption value="Onnx" text="@add.kind.Onnx"/>
  </DvSelect>
  <DvRow gap="sm">
    <DvSpacer/>
    <DvButton id="cancel" variant="secondary" text="@add.cancel" onclick="Cancel"/>
    <DvButton id="ok" variant="primary" text="@add.ok" onclick="Ok" disabled="{CannotAdd}"/>
  </DvRow>
</DvDialogFrame>
