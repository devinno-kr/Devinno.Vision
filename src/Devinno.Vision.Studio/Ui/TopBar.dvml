<DvRow vm="Devinno.Vision.Studio.Ui.TopBar" style="height:56; padding:0 16; gap:8; background: token(surface-raised); border: 1 token(border); box-shadow: 0 2 8 #00000066">
  <DvStyle>
    .tab { padding:8 20; border-radius: token(radius.md); color: token(text-muted); font-size: token(font.body); font-weight: bold }
    .tab:hover { background: token(surface-overlay); color: token(text) }
    .tab-active, .tab-active:hover { background: token(primary); color: token(primary-fg) }
  </DvStyle>
  <DvButton id="btnNew" variant="secondary" icon="fa-file-circle-plus" text="새 로직" onclick="New"/>
  <DvButton id="btnOpen" variant="secondary" icon="fa-folder-open" text="열기" onclick="Open"/>
  <DvButton id="btnSave" variant="secondary" icon="fa-floppy-disk" text="저장" onclick="Save" disabled="{NoProject}"/>
  <DvBox style="width:16"/>
  <DvLabel class="title" text="{Title}" style="white-space:nowrap"/>
  <DvLabel class="caption" text="{FolderText}" style="white-space:nowrap"/>
  <DvSpacer/>
  <DvButton class="{EditClass}" text="편집" onclick="ShowEdit"/>
  <DvButton class="{TestClass}" text="테스트" onclick="ShowTest"/>
</DvRow>
