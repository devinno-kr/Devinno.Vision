<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Devinno.Vision.Studio</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devinno.Vision\Devinno.Vision.csproj" />
    <ProjectReference Include="..\Devinno.Vision.UI\Devinno.Vision.UI.csproj" />
    <!-- 개발 중에는 Devinno.UI 를 로컬 프로젝트로 참조한다 -->
    <ProjectReference Include="..\..\..\Devinno.UI\src\Devinno.UI.WinForms\Devinno.UI.WinForms.csproj" />
    <ProjectReference Include="..\..\..\Devinno.UI\src\Devinno.UI.Generators\Devinno.UI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="**/*.dvml" Exclude="$(DefaultItemExcludes)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devinno.Vision.Studio.Tests" />
  </ItemGroup>

  <!-- 양품 모델의 특징 모델 (ResNet18 layer2+3, 11 MB). *.onnx 는 git 제외 — tools/export_features.py tools/models/features.onnx 로 만든다.
       없으면 Studio 는 학습할 때 만드는 방법을 알려 준다 -->
  <ItemGroup Condition="Exists('../../tools/models/features.onnx')">
    <None Include="../../tools/models/features.onnx" Link="models/features.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 불량 학습: 스크립트는 저장소에 있고, ImageNet ResNet18 가중치(45 MB, git 제외)는 있으면 같이 둔다 (없으면 스크립트가 내려받기를 시도) -->
  <ItemGroup>
    <None Include="../../tools/train_defect.py" Link="train/train_defect.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../tools/models/resnet18-f37072fd.pth')">
    <None Include="../../tools/models/resnet18-f37072fd.pth" Link="models/resnet18-f37072fd.pth" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
