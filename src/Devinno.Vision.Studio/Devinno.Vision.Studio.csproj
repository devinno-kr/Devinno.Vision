<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Devinno.Vision.Studio</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Studio 의 버전은 라이브러리(NuGet)와 따로 간다. 릴리스 워크플로(release-studio.yml)가 태그 studio-v1.2.3 에서 StudioVersion 을 넘긴다 -->
    <Version>0.1.0</Version>
    <Version Condition="'$(StudioVersion)' != ''">$(StudioVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devinno.Vision\Devinno.Vision.csproj" />
    <ProjectReference Include="..\Devinno.Vision.UI\Devinno.Vision.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 카메라 에뮬레이터의 Modbus TCP 슬레이브 -->
    <PackageReference Include="Devinno.Communication" Version="0.2.0" />
    <!-- 화면. Devinno.UI 패키지가 dvml 소스 생성기를 가져오고 *.dvml 을 넘긴다. Devinno.Vision.UI 의 Devinno.UI 와 같은 버전으로 둔다 -->
    <PackageReference Include="Devinno.UI.WinForms" Version="0.7.1" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Devinno.Vision.Studio.Tests" />
  </ItemGroup>

  <!-- 화면 · 명령 결과 문구 (Texts.cs 가 읽음). 한국어 · 영어 -->
  <ItemGroup>
    <None Update="Strings\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 양품 모델의 특징 모델 (ResNet18 layer2+3, 11 MB). *.onnx 는 git 제외 — tools/export_features.py tools/models/features.onnx 로 만든다.
       없으면 Studio 는 학습할 때 만드는 방법을 알려 준다 -->
  <ItemGroup Condition="Exists('../../tools/models/features.onnx')">
    <None Include="../../tools/models/features.onnx" Link="models/features.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 불량 학습: 스크립트는 저장소에 있고, ImageNet ResNet18 가중치(45 MB, git 제외)는 있으면 같이 둔다 (없으면 스크립트가 내려받기를 시도) -->
  <ItemGroup>
    <None Include="../../tools/train_defect.py" Link="train/train_defect.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 카메라 에뮬레이터의 RTSP 서버 (MediaMTX v1.21.3, MIT, git 제외 — tools/mediamtx 에 둔다) -->
  <ItemGroup Condition="Exists('../../tools/mediamtx/mediamtx.exe')">
    <None Include="../../tools/mediamtx/mediamtx.exe;../../tools/mediamtx/LICENSE" Link="tools/mediamtx/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('../../tools/models/resnet18-f37072fd.pth')">
    <None Include="../../tools/models/resnet18-f37072fd.pth" Link="models/resnet18-f37072fd.pth" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
