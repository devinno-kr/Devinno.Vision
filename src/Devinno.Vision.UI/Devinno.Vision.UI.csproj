<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Devinno.Vision.UI</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591;CS1573</WarningsAsErrors>

    <PackageId>Devinno.Vision.UI</PackageId>
    <Version>0.1.1</Version>
    <Authors>Devinno</Authors>
    <Company>Devinno</Company>
    <Description>Result view for Devinno.Vision on Devinno.UI — image, overlays, judgment, disabled-step warning and ROI drag editing.</Description>
    <PackageTags>vision;inspection;machine-vision;ui;hmi;devinno-ui;industrial</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Devinno</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Devinno.Vision\Devinno.Vision.csproj" />
    <!-- 코어(Devinno.Vision)는 Devinno.UI 를 모른다. Studio 의 Devinno.UI.WinForms 와 같은 버전으로 둔다 -->
    <PackageReference Include="Devinno.UI" Version="0.7.1" />
  </ItemGroup>

</Project>
