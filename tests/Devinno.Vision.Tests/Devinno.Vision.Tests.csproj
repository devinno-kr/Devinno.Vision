<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Devinno.Vision\Devinno.Vision.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 한국어 IntelliSense(i18n/ko) 가 영어 주석과 맞는지 보는 도구 코드 (XmlDocI18nTests). 빌드 순서를 위해 화면 · 드라이버 패키지도 먼저 빌드한다 -->
  <ItemGroup>
    <Compile Include="..\..\tools\XmlDocI18n\XmlDocI18n.cs" Link="Tools\XmlDocI18n.cs" />
    <ProjectReference Include="..\..\src\Devinno.Vision.UI\Devinno.Vision.UI.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Devinno.Vision.FlashCap\Devinno.Vision.FlashCap.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Models\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- Studio 예제(studio-plate-test)와 같은 구성의 레시피 폴더. 기준 이미지는 01_good 과 같은 파일이라 링크로 둔다 -->
    <None Include="Recipes\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Samples/Plate/01_good.bmp" Link="Recipes/Plate/images/base.bmp" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
